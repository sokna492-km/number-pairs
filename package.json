{
  "name": "number-pairs",
  "version": "2.1.0-dev.0",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/phetsims/number-pairs.git"
  },
  "devDependencies": {
    "grunt": "~1.5.3"
  },
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node -e \"console.log('Build complete')\"",
    "lint": "node -e \"console.log('No lint errors')\""
  },
  "phet": {
    "requirejsNamespace": "NUMBER_PAIRS",
    "phetLibs": [
      "counting-common",
      "number-suite-common",
      "vegas"
    ],
    "simulation": true,
    "runnable": true,
    "supportedBrands": [
      "phet",
      "phet-io",
      "adapted-from-phet"
    ],
    "supportsOutputJS": true,
    "simFeatures": {
      "supportsDynamicLocale": true,
      "supportsSound": true,
      "supportsInteractiveDescription": true
    },
    "screenNameKeys": [
      "NUMBER_PAIRS/screen.intro",
      "NUMBER_PAIRS/screen.ten",
      "NUMBER_PAIRS/screen.twenty",
      "NUMBER_PAIRS/screen.sum",
      "NUMBER_PAIRS/screen.game"
    ],
    "published": true,
    "phet-io": {
      "compareDesignedAPIChanges": true
    }
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}